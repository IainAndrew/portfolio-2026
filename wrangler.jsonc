// Cloudflare Workers static-assets deployment. No Worker script, just files.
// Deploy: npx wrangler deploy (or let Workers Builds deploy on push to main).
{
  "name": "iainandrew",
  "compatibility_date": "2026-11-04",
  // The site lives at iainandrew.com only; no second URL on workers.dev.
  "workers_dev": false,
  "assets": {
    // Only public/ is published. notes/, scripts/ and config stay out of the site.
    "directory": "./public",
    // /about/index.html is served at /about/ and /about redirects to /about/.
    "html_handling": "auto-trailing-slash",
    // Unknown paths return a 404 with public/404.html once there is one.
    "not_found_handling": "404-page"
  }
}
